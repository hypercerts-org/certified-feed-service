{
  "lexicon": 1,
  "id": "app.certified.feed.beta.defs",
  "description": "Shared wire definitions for Certified feed procedures.",
  "defs": {
    "certifiedFeed": {
      "type": "token",
      "description": "Identifies the Certified viewer-scope feed algorithm."
    },
    "certifiedFeedParams": {
      "type": "object",
      "required": ["viewerDid"],
      "description": "Parameters accepted by the Certified viewer-scope feed algorithm.",
      "properties": {
        "viewerDid": {
          "type": "string",
          "format": "did",
          "maxLength": 256,
          "description": "Viewer whose current Certified follows supply the base author scope."
        },
        "trustedEvaluators": {
          "type": "array",
          "maxLength": 128,
          "description": "Evaluator DIDs whose active endorsement subjects extend the author scope.",
          "items": { "type": "string", "format": "did", "maxLength": 256 }
        },
        "organizationQuality": {
          "type": "ref",
          "ref": "app.certified.feed.beta.defs#organizationQualityPolicy"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20,
          "description": "Maximum number of feed items to return."
        },
        "cursor": {
          "type": "string",
          "maxLength": 4096,
          "description": "Opaque keyset cursor returned by a previous request."
        },
        "kinds": {
          "type": "array",
          "maxLength": 32,
          "description": "Final event kinds to include. Omitted or empty means every supported kind.",
          "items": {
            "type": "string",
            "maxLength": 64,
            "knownValues": [
              "cert.create",
              "collection.create",
              "project.created_with_cert",
              "evaluation.create",
              "measurement.create",
              "hyperboard.create",
              "update.create",
              "endorsement.award"
            ]
          }
        }
      }
    },
    "organizationQualityPolicy": {
      "type": "object",
      "required": ["allowed", "includeUnrated"],
      "description": "Controls which known organizations qualify before event pagination.",
      "properties": {
        "allowed": {
          "type": "array",
          "maxLength": 8,
          "items": {
            "type": "string",
            "maxLength": 32,
            "knownValues": ["high-quality", "standard", "draft", "likely-test"]
          },
          "description": "Organization quality values allowed into the feed."
        },
        "includeUnrated": {
          "type": "boolean",
          "description": "Whether known organizations without an active trusted quality label qualify."
        }
      }
    },
    "actorSummary": {
      "type": "object",
      "description": "Validated current identity fields for one feed actor.",
      "properties": {
        "did": { "type": "string", "format": "did" },
        "handle": { "type": "string", "format": "handle", "maxLength": 253 },
        "displayName": { "type": "string", "maxLength": 640, "maxGraphemes": 64 },
        "avatar": {
          "type": "union",
          "refs": [
            "org.hypercerts.defs#uri",
            "org.hypercerts.defs#smallImage"
          ]
        }
      }
    },
    "activityView": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "shortDescription": { "type": "string" },
        "image": {
          "type": "union",
          "refs": [
            "org.hypercerts.defs#uri",
            "org.hypercerts.defs#smallImage"
          ]
        },
        "createdAt": { "type": "string", "format": "datetime" },
        "startDate": { "type": "string", "format": "datetime" },
        "endDate": { "type": "string", "format": "datetime" },
        "locationCount": { "type": "integer", "minimum": 0 }
      }
    },
    "collectionView": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "collectionType": { "type": "string" },
        "title": { "type": "string" },
        "shortDescription": { "type": "string" },
        "image": {
          "type": "union",
          "refs": [
            "org.hypercerts.defs#uri",
            "org.hypercerts.defs#smallImage",
            "org.hypercerts.defs#largeImage"
          ]
        },
        "createdAt": { "type": "string", "format": "datetime" },
        "itemCount": { "type": "integer", "minimum": 0 }
      }
    },
    "endorsementView": {
      "type": "object",
      "required": ["subject"],
      "properties": {
        "subject": { "type": "ref", "ref": "#actorSummary" },
        "createdAt": { "type": "string", "format": "datetime" }
      }
    },
    "evaluationView": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "createdAt": { "type": "string", "format": "datetime" },
        "target": { "type": "ref", "ref": "com.atproto.repo.strongRef" }
      }
    },
    "measurementView": {
      "type": "object",
      "properties": {
        "metric": { "type": "string" },
        "createdAt": { "type": "string", "format": "datetime" },
        "target": { "type": "ref", "ref": "com.atproto.repo.strongRef" }
      }
    },
    "hyperboardView": {
      "type": "object",
      "properties": {
        "createdAt": { "type": "string", "format": "datetime" }
      }
    },
    "updateView": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "shortDescription": { "type": "string" },
        "image": {
          "type": "union",
          "refs": [
            "org.hypercerts.defs#uri",
            "org.hypercerts.defs#smallBlob"
          ]
        },
        "createdAt": { "type": "string", "format": "datetime" },
        "target": { "type": "ref", "ref": "com.atproto.repo.strongRef" }
      }
    },
    "certifiedFeedView": {
      "type": "object",
      "required": ["kind", "actor", "content"],
      "description": "Hydrated representation of one entry from the Certified viewer-scope feed.",
      "properties": {
        "kind": {
          "type": "string",
          "maxLength": 64,
          "knownValues": [
            "cert.create",
            "collection.create",
            "project.created_with_cert",
            "evaluation.create",
            "measurement.create",
            "hyperboard.create",
            "update.create",
            "endorsement.award"
          ],
          "description": "Certified event classification used to interpret and present the entry."
        },
        "actor": { "type": "ref", "ref": "#actorSummary" },
        "content": {
          "type": "union",
          "closed": false,
          "refs": [
            "#activityView",
            "#collectionView",
            "#endorsementView",
            "#evaluationView",
            "#measurementView",
            "#hyperboardView",
            "#updateView"
          ],
          "description": "Kind-specific content needed to present the entry."
        }
      }
    }
  }
}

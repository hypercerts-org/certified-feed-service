{
  "lexicon": 1,
  "id": "app.certified.feed.beta.defs",
  "description": "Shared wire definitions for Certified feed procedures.",
  "defs": {
    "organizationQualityPolicy": {
      "type": "object",
      "required": ["allowed", "includeUnrated"],
      "description": "Controls which known organizations qualify before event pagination.",
      "properties": {
        "allowed": {
          "type": "array",
          "maxLength": 8,
          "items": {
            "type": "string",
            "maxLength": 32,
            "knownValues": ["high-quality", "standard", "draft", "likely-test"]
          },
          "description": "Organization quality values allowed into the feed."
        },
        "includeUnrated": {
          "type": "boolean",
          "description": "Whether known organizations without an active trusted quality label qualify."
        }
      }
    },
    "actorSummary": {
      "type": "object",
      "description": "Validated current identity fields for one feed actor.",
      "properties": {
        "did": { "type": "string", "format": "did" },
        "handle": { "type": "string", "format": "handle", "maxLength": 253 },
        "displayName": { "type": "string", "maxLength": 640, "maxGraphemes": 64 },
        "avatar": {
          "type": "union",
          "refs": [
            "org.hypercerts.defs#uri",
            "org.hypercerts.defs#smallImage"
          ]
        }
      }
    },
    "activityView": {
      "type": "object",
      "required": ["title", "locationCount"],
      "properties": {
        "title": { "type": "string" },
        "shortDescription": { "type": "string" },
        "image": {
          "type": "union",
          "refs": [
            "org.hypercerts.defs#uri",
            "org.hypercerts.defs#smallImage"
          ]
        },
        "createdAt": { "type": "string", "format": "datetime" },
        "startDate": { "type": "string", "format": "datetime" },
        "endDate": { "type": "string", "format": "datetime" },
        "locationCount": { "type": "integer", "minimum": 0 }
      }
    },
    "collectionView": {
      "type": "object",
      "required": ["title", "itemCount"],
      "properties": {
        "collectionType": { "type": "string" },
        "title": { "type": "string" },
        "shortDescription": { "type": "string" },
        "image": {
          "type": "union",
          "refs": [
            "org.hypercerts.defs#uri",
            "org.hypercerts.defs#smallImage",
            "org.hypercerts.defs#largeImage"
          ]
        },
        "createdAt": { "type": "string", "format": "datetime" },
        "itemCount": { "type": "integer", "minimum": 0 }
      }
    },
    "endorsementView": {
      "type": "object",
      "required": ["subject"],
      "properties": {
        "subject": { "type": "ref", "ref": "#actorSummary" },
        "createdAt": { "type": "string", "format": "datetime" }
      }
    },
    "evaluationView": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "createdAt": { "type": "string", "format": "datetime" },
        "target": { "type": "ref", "ref": "com.atproto.repo.strongRef" }
      }
    },
    "measurementView": {
      "type": "object",
      "properties": {
        "metric": { "type": "string" },
        "createdAt": { "type": "string", "format": "datetime" },
        "target": { "type": "ref", "ref": "com.atproto.repo.strongRef" }
      }
    },
    "hyperboardView": {
      "type": "object",
      "properties": {
        "createdAt": { "type": "string", "format": "datetime" }
      }
    },
    "updateView": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "shortDescription": { "type": "string" },
        "image": {
          "type": "union",
          "refs": [
            "org.hypercerts.defs#uri",
            "org.hypercerts.defs#smallBlob"
          ]
        },
        "createdAt": { "type": "string", "format": "datetime" },
        "target": { "type": "ref", "ref": "com.atproto.repo.strongRef" }
      }
    },
    "feedItem": {
      "type": "object",
      "required": ["id", "kind", "subject", "sortAt", "actor", "view"],
      "description": "A feed event whose indexed source record was validated and projected into a view.",
      "properties": {
        "id": {
          "type": "string",
          "format": "at-uri",
          "description": "Stable event identifier, currently the source record AT URI."
        },
        "kind": {
          "type": "string",
          "maxLength": 64,
          "knownValues": [
            "cert.create",
            "collection.create",
            "project.created_with_cert",
            "evaluation.create",
            "measurement.create",
            "hyperboard.create",
            "update.create",
            "endorsement.award"
          ]
        },
        "subject": { "type": "ref", "ref": "com.atproto.repo.strongRef" },
        "sortAt": {
          "type": "string",
          "format": "datetime",
          "description": "Effective timestamp used to order this item."
        },
        "actor": { "type": "ref", "ref": "#actorSummary" },
        "view": {
          "type": "union",
          "refs": [
            "#activityView",
            "#collectionView",
            "#endorsementView",
            "#evaluationView",
            "#measurementView",
            "#hyperboardView",
            "#updateView"
          ]
        }
      }
    }
  }
}

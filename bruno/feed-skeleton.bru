meta {
  name: Feed skeleton
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/xrpc/org.hypercerts.feed.getFeedSkeleton
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "feedId": "{{feedId}}",
    "params": {
      "$type": "{{feedParamsType}}",
      "viewerDid": "{{viewerDid}}"
    },
    "limit": {{limit}},
    "cursor": "{{cursor}}"
  }
}

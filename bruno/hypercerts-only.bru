meta {
  name: Hypercerts only
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/xrpc/org.hypercerts.feed.getFeed
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "feedId": "{{feedId}}",
    "params": {
      "$type": "{{feedParamsType}}",
      "viewerDid": "{{viewerDid}}",
      "kinds": ["cert.create"]
    },
    "limit": {{limit}},
    "cursor": "{{cursor}}"
  }
}
